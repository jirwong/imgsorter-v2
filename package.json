{
  "name": "imgsorter-v2",
  "version": "1.0.0",
  "description": "A utility for indexing local files and detecting duplicates across directories",
  "scripts": {
    "prepare": "lefthook install",
    "build": "esbuild src/index.ts --bundle --platform=node --packages=external --outfile=dist/index.js",
    "start": "tsx src/index.ts",
    "dev": "tsx src/index.ts",
    "dev:watch": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm format:check"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.2",
    "lefthook": "^2.1.10",
    "lint-staged": "^17.3.0",
    "oxlint": "^1.77.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "commander": "^15.0.0",
    "nanospinner": "^1.2.2",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
